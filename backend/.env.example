SMART_ROSTER_APP_NAME="Smart Roster Management API"
SMART_ROSTER_APP_VERSION="1.0.0"
SMART_ROSTER_API_PREFIX="/api/v1"
SMART_ROSTER_ENVIRONMENT=development
SMART_ROSTER_DEBUG=false
SMART_ROSTER_ALLOWED_FRONTEND_ORIGINS='["http://localhost:5173"]'
STORAGE_BACKEND=mongodb
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=smart_roster_dev
